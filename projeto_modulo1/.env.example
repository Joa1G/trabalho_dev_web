# Banco de dados — replicado pelo docker-compose
DB_NAME=modulo1_alocacao
DB_USER=user_modulo1
DB_PASSWORD=senha123
DB_HOST=localhost
DB_PORT=5432
# Porta que o container expõe no HOST.
# Em uma máquina limpa pode ficar 5432; aqui usamos 5433 porque já existe outro Postgres em 5432.
DB_HOST_PORT=5432

# Django
DJANGO_SECRET_KEY=dev-secret-troque-em-producao-min-32-bytes-XXXXXXXXXXXX
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Seed admin de desenvolvimento
DEV_ADMIN_EMAIL=admin@instituicao.edu.br
DEV_ADMIN_PASSWORD=admin123
