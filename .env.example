# Banco de dados.
# Estas variáveis valem para AMBOS os cenários (o Django só lê daqui):
#   - COM Docker:  o docker-compose sobe um Postgres com exatamente estes valores.
#   - SEM Docker:  aponte DB_HOST/DB_PORT para um Postgres instalado localmente
#                  (criado via pgAdmin). Tutorial: docs/SETUP_PGADMIN.md
DB_NAME=modulo1_alocacao
DB_USER=user_modulo1
DB_PASSWORD=senha123
DB_HOST=localhost
DB_PORT=5432
# Porta que o CONTAINER expõe no HOST (só importa no cenário com Docker).
# Em uma máquina limpa pode ficar 5432; use outra (ex.: 5433) se a 5432 já estiver
# ocupada por outro Postgres. SEM Docker, ignore esta linha e use DB_PORT acima.
DB_HOST_PORT=5432

# Django
DJANGO_SECRET_KEY=dev-secret-troque-em-producao-min-32-bytes-XXXXXXXXXXXX
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Seed admin de desenvolvimento
DEV_ADMIN_EMAIL=admin@instituicao.edu.br
DEV_ADMIN_PASSWORD=admin123
